<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/boot_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/boot_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/boot_title"
            android:textColor="#ECECEC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/boot_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#A6A6A6"
            android:textSize="15sp"
            android:text="@string/boot_starting" />

        <TextView
            android:id="@+id/boot_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:gravity="start"
            android:maxLines="12"
            android:scrollbars="vertical"
            android:textColor="#829691"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/boot_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/boot_retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
